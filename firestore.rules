rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.uid.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 50)) &&
             (!('theme' in data) || (data.theme is string && data.theme.size() <= 20)) &&
             (!('notifications' in data) || (data.notifications is bool));
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc used by client validation
    match /test/connection {
      allow read: if true;
    }

    // User Profile collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == request.auth.uid &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == existing().uid &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId) && isValidId(userId);

      // User's security activity logs subcollection
      match /securityLogs/{logId} {
        allow read: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(logId) &&
                         incoming().uid == request.auth.uid;
        allow update, delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }
    }
  }
}
