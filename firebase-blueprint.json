{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and account customization settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500000 },
        "bio": { "type": "string", "maxLength": 500 },
        "timezone": { "type": "string", "maxLength": 50 },
        "theme": { "type": "string", "maxLength": 20 },
        "notifications": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "User security activity and audit trail",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string" },
        "device": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "action", "timestamp", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profile records"
    },
    "/users/{userId}/securityLogs/{logId}": {
      "schema": "SecurityLog",
      "description": "Audit logs for account actions"
    }
  }
}
